# Copy this file to .env and fill in real local secrets there.
# Never put real API keys in .env.example.

# Required for Mistral-powered title, summary, extraction, and RAG answers.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional. Required only when Language is set to "hinglish".
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# Optional. Whisper model used for English transcription.
# Options commonly include tiny, base, small, medium, large.
WHISPER_MODEL=small

# Optional. Used by test.py to run the smoke test without interactive input.
SMOKE_TEST_SOURCE=
SMOKE_TEST_LANGUAGE=english
